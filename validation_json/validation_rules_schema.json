            }
        },
        "aws_s3_path": {
            "type": "string",
            "required": true,
            "regex": "^s3://.+",
            "dependencies": {
                "file_source_platform": ["bti_aws", "bti_aws_and_local_drive"]
            }
        },
        "sequencing_batch": {
            "type": "string",
            "required": false
        },
        "host_organism": {
            "type": "string",
            "required": true,
            "allowed": ["Mus musculus"],
            "dependencies": {
                "composition": [
                    "Patient Derived Xenograft",
                    "Xenograft"
                ]
            }
        },
        "sample_type": {
            "type": "string",
            "required": true,
            "allowed": [
                "Tumor",
                "Normal",
                "Unknown",
                "Virus-infected",
                "Not Reported"
            ]
        },
        "tumor_descriptor": {
            "type": "string",
            "required": true,
            "anyof": [
                {
                    "allowed": ["NA"],
                    "dependencies": {
                        "sample_type": ["Normal"]
                    }
                },
                {
                    "allowed": [
                        "Deceased",
                        "Initial CNS Tumor",
                        "Metastatic",
                        "Post-treatment",
                        "Primary Tumor",
                        "Progressive",
                        "Progressive Disease Post-Mortem",
                        "Recurrence",
                        "Relapse",
                        "Residual",
                        "Second Malignancy",
                        "Unknown",
                        "NA"
                    ],
                    "dependencies": {
                        "sample_type": [
                            "Tumor",
                            "Unknown",
                            "Virus-infected",
                            "Not Reported"
                        ]
                    }
                }
            ]
        },
        "organism": {
            "type": "string",
            "required": true,
            "allowed": [
                "Homo sapiens",
                "Mus musculus"
            ]
        },
        "total_reads": {
            "required": false,
            "nullable": true
        },
        "flow_cell_barcode": {
            "type": "string",
            "required": true,
            "dependencies": {
                "file_format": [
                    "FASTQ"
                ]
            },
            "nullable": true
        },
        "lane_number": {
            "type": "string",
            "required": false,
            "dependencies": {
                "file_format": [
                    "FASTQ"
                ]
            },
            "nullable": true
        }
    },
