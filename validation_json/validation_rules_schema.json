{
    "custom_rules": {
        "_comment": "Add custom fields that Cerberus doesn't recognize as valid schema rules.",
        "file_size_byte_cutoff": {
            "_comment": "Optional strategy-specific file_size thresholds. Do not apply a general cutoff across all data types.",
            "type": "integer",
            "wgs_wxs_cutoff": 200000000,
            "bulk_rnaseq_cutoff": 100000000,
            "bulk_rnaseq_strategies": [
                "RNA-Seq"
            ],
            "dependencies": {
                "file_format": [
                    "FASTQ",
                    "BAM",
                    "CRAM"
                ]
            }
        },
        "file_name_extensions": {
            "bam": ".bam",
            "bai": ".bai",
            "cram": ".cram",
            "crai": ".crai"
        }
    },
    "common_rules": {
