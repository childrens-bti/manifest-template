                ]
            }
        },
        "timepoint": {
            "type": "string",
            "required": false
        },
        "parental_model_id": {
            "type": "string",
            "required": true,
            "dependencies": {
                "composition": [
                    "Derived Cell Line",
                    "Patient Derived Xenograft",
                    "Xenograft",
                    "Patient Derived Organoid",
                    "iPSC-Derived Organoid",
                    "Embryonic Stem Cell Derived Cell Line"
                ]
            }
