        "instrument_platform": {
            "type": "string",
            "required": true,
            "allowed": [
                "Complete Genomics",
                "Illumina",
                "Ion Torrent",
                "LS454",
                "SOLiD",
                "ONT",
                "DNBSEQ",
                "Other"
            ]
        },
        "experimental_strategy": {
          "type": "string",
          "required": true,
          "allowed": [
            "scRNA-Seq",
            "snRNA-Seq",
            "CITE-Seq",
            "scTCR-Seq",
            "scBCR-Seq",
            "10x Flex GEX",
            "Spatial Transcriptomics"
          ]
        },
        "chain_type": {
            "type": "string",
            "required": true,
            "dependencies": {
                "experimental_strategy": ["scBCR-Seq", "scTCR-Seq"]
            },
            "anyof": [
                {
                    "allowed": ["IGH", "IGK", "IGL"],
                    "dependencies": {
                        "experimental_strategy": "scBCR-Seq"
                    }
                },
                {
                    "allowed": ["TCRa", "TCRb"],
                    "dependencies": {
                        "experimental_strategy": "scTCR-Seq"
                    }
                }
            ]
        },
        "library_type": {
            "type": "string",
            "required": true,
            "anyof": [
                {
                    "allowed": ["GEX", "ADT"],
                    "dependencies": {
                        "experimental_strategy": "CITE-Seq"
                    }
                },
                {
                    "allowed": ["GEX"],
                    "dependencies": {
                        "experimental_strategy": ["scRNA-Seq", "snRNA-Seq", "10x Flex GEX", "Spatial Transcriptomics"]
                    }
                },
                {
                    "allowed": ["scTCR", "GEX", "VDJ-T"],
                    "dependencies": {
                        "experimental_strategy": "scTCR-Seq"
                    }
                },
                {
                    "allowed": ["scBCR", "GEX", "VDJ-B"],
