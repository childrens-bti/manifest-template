                    }
                },
                {
                    "allowed": [
                        "exome capture",
                        "fragmented",
                        "poly-A",
                        "poly-A stranded",
                        "poly-A unstranded",
                        "RPFs",
                        "total RNA stranded",
                        "total RNA unstranded",
                        "Unknown"
                    ],
                    "dependencies": {
                        "experimental_strategy": [
                            "RNA-Seq",
                            "Ribo-Seq",
                            "long-read RNA-Seq",
                            "Flash-Seq"
                        ]
                    }
                }
            ]
        },
        "read_pair_number": {
            "type": "string",
            "required": true,
            "allowed": [
                "R1",
                "R2",
                "NA"
            ],
            "dependencies": {
                "file_format": "FASTQ"
            }
        },
        "is_paired_end": {
            "type": "boolean",
            "required": true,
            "dependencies": {
                "file_format": [
                    "FASTQ",
                    "BAM"
                ]
            }
        },
        "is_adapter_trimmed": {
            "type": ["boolean", "string"],
            "required": false,
            "allowed": [true, false, "Unknown"],
            "dependencies": {
                "file_format": [
                    "FASTQ"
                ]
            }
        },
        "adapter_sequencing": {
            "type": "string",
            "required": false,
            "dependencies": {
                "is_adapter_trimmed": false
            }
        }
    },
    "single_cell_rules": {
        "organism": {
            "required": true
        },
